# ---------------------------------------------------------------------------------------------
# Smart Society API configuration. Copy to apps/api/.env (or set in your host's secret manager).
# Never commit real values. Everything below is a safe placeholder.
# ---------------------------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=4000

# REQUIRED. MongoDB 6+ (Atlas or self-hosted). Example for a local server:
MONGODB_URI=mongodb://127.0.0.1:27017/smartsociety

# Comma-separated browser origins allowed to call the API with credentials.
WEB_ORIGIN=http://localhost:5173
# Public URL of the web app, used in invitation and password-reset links (defaults to the first WEB_ORIGIN).
APP_URL=http://localhost:5173

# Cookies: Secure is forced on in production (and the __Host- cookie prefix is used).
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting / audit).
TRUST_PROXY=0

SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=48

# Uploaded complaint photos/PDFs (local disk). Mount a persistent volume here in production.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

LOG_LEVEL=info

# Email: none | console (development only — writes emails to the API log) | smtp
# Invitations still work without email: the inviter is shown a private link to share.
# Password reset by email REQUIRES smtp (or console in development).
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Smart Society <no-reply@example.com>"

# Development/test only; refused in production.
RATE_LIMIT_DISABLED=false

# Seed script only (npm run seed). Demo accounts use the reserved *.invalid domain.
SEED_DEMO_PASSWORD=demo-pass-2026

# Not implemented in this version (no adapters): SMS, WhatsApp, push notifications, payments, AI.
