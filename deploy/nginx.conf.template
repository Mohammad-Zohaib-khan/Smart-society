# Serves the built web app and proxies /api to the API container on the same origin,
# so session cookies stay first-party. TLS is terminated in front (Azure Container Apps / App
# Service ingress, a load balancer, or certbot).
#
# This is an nginx *template*: the official image runs envsubst on /etc/nginx/templates/*.template
# at start-up, substituting only variables that exist in the environment (nginx's own $vars are
# left alone). Set API_UPSTREAM to where the API is reachable, e.g.
#   docker compose:              http://api:4000            (default in apps/web/Dockerfile)
#   Azure Container Apps:        http://<api-app-name>      (internal ingress, port 80)

# Keep the original scheme when TLS ends at an upstream ingress; fall back to our own.
map $http_x_forwarded_proto $forwarded_proto {
  default $http_x_forwarded_proto;
  ''      $scheme;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 20m;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header X-Frame-Options DENY always;
  # The hash allows the small inline theme script in index.html (recompute if you edit it).
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-ReBMe4L6geHFtBizEqAlk2+18X/UGkXS/Sh+AvBlH1A='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
  # Browsers ignore HSTS on plain-HTTP responses, so this is safe for local http and active on Azure.
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  # Liveness/readiness probe for the web container itself (does not touch the API).
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok";
  }

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    # nginx defaults to HTTP/1.0 upstream; Azure's Envoy ingress rejects that with 426.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    # Host must be the upstream's own name: Azure's internal ingress routes by Host header.
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_read_timeout 60s;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    # add_header in a location replaces the server-level ones, so repeat the security headers.
    add_header X-Content-Type-Options nosniff always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-ReBMe4L6geHFtBizEqAlk2+18X/UGkXS/Sh+AvBlH1A='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    try_files $uri /index.html;
  }
}
