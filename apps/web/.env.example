# Web app build-time settings (Vite). Copy to apps/web/.env.local if you need to change them.
# By default the app calls /api on its own origin (the dev server and the nginx config proxy it).
# Set this only when the API lives on another origin of the SAME SITE (e.g. api.example.com for
# app.example.com) — session cookies are SameSite=Lax.
# VITE_API_URL=https://api.example.com/api

# Dev/preview only: where the Vite proxy forwards /api.
# VITE_API_PROXY=http://localhost:4000
